{
  "info": {
    "name": "Sistema de Gerenciamento de Eventos",
    "description": "Coleção de testes de API para o trabalho final de Teste de Software.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('API está online', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - CT-022 Login válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario@email.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Retorna token', function () { pm.expect(body.token).to.be.a('string'); });",
              "if (body.token) pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - CT-023 Login inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario@email.com\",\n  \"senha\": \"senhaerrada\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Mensagem de credenciais inválidas', function () { pm.expect(pm.response.json().message).to.include('Credenciais inválidas'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - CT-016 Cadastrar evento válido",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Feira de Tecnologia\",\n  \"descricao\": \"Evento sobre inovação e tecnologia\",\n  \"data\": \"2026-10-25\",\n  \"horario\": \"19:00\",\n  \"local\": \"Brasília\",\n  \"vagas\": 100,\n  \"status\": \"Ativo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Evento cadastrado', function () { pm.expect(body.event.nome).to.eql('Feira de Tecnologia'); });",
              "if (body.event && body.event.id) pm.collectionVariables.set('eventId', body.event.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - CT-017 Cadastro sem nome",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\",\n  \"descricao\": \"Evento inválido\",\n  \"data\": \"2026-10-25\",\n  \"horario\": \"19:00\",\n  \"local\": \"Brasília\",\n  \"vagas\": 100,\n  \"status\": \"Ativo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Nome obrigatório', function () { pm.expect(pm.response.json().message.toLowerCase()).to.include('nome'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - CT-018 Consultar eventos",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Retorna uma lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - CT-019 Editar evento",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Feira de Tecnologia Atualizada\",\n  \"descricao\": \"Evento atualizado sobre inovação e tecnologia\",\n  \"data\": \"2026-10-25\",\n  \"horario\": \"20:00\",\n  \"local\": \"Centro de Convenções Ulysses Guimarães\",\n  \"vagas\": 150,\n  \"status\": \"Ativo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            "{{eventId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Nome atualizado', function () { pm.expect(pm.response.json().event.nome).to.include('Atualizada'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - CT-021 Evento inexistente",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Evento não encontrado', function () { pm.expect(pm.response.json().message).to.include('não encontrado'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - CT-020 Excluir evento",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            "{{eventId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Exclusão concluída', function () { pm.expect(pm.response.json().message).to.include('excluído'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CT-035 Rejeita horario inválido",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Feira de Tecnologia\", \"descricao\": \"Evento sobre inovação e tecnologia\", \"data\": \"2026-10-25\", \"horario\": \"99:99\", \"local\": \"Brasília\", \"vagas\": 100, \"status\": \"Ativo\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rejeita dados inválidos',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT-036 Rejeita status inválido",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Feira de Tecnologia\", \"descricao\": \"Evento sobre inovação e tecnologia\", \"data\": \"2026-10-25\", \"horario\": \"19:00\", \"local\": \"Brasília\", \"vagas\": 100, \"status\": \"Inventado\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rejeita dados inválidos',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT-037 Bloqueia API sem token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Sem token retorna 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}